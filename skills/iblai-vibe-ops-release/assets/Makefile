# App-store build & submit — generated by /iblai-vibe-ops-release
#
# Fills its config from fastlane/.env (copy fastlane/.env.example first).
# Binaries are produced by Tauri; Fastlane creates app records and uploads.
#
# Quick start:
#   make doctor          # check tooling + credentials
#   make ios-release     # build .ipa  -> TestFlight
#   make android-release # build .aab  -> Play internal track

ENV_FILE ?= fastlane/.env
-include $(ENV_FILE)
export

# Artifact discovery (override on the command line if needed):
#   make ios-submit IPA_PATH=path/to/App.ipa
IPA_GLOB := src-tauri/gen/apple
AAB_GLOB := src-tauri/gen/android/app/build/outputs/bundle

.DEFAULT_GOAL := help
.PHONY: help doctor bump \
        ios-create ios-build ios-submit ios-release \
        android-create android-build android-submit android-release \
        release-all

help: ## List available targets
	@grep -hE '^[a-zA-Z0-9_-]+:.*?## ' $(MAKEFILE_LIST) \
		| awk 'BEGIN{FS=":.*?## "}{printf "  \033[36m%-18s\033[0m %s\n", $$1, $$2}'

doctor: ## Check tooling and that credentials are present
	@echo "== tooling =="
	@command -v fastlane >/dev/null 2>&1 && echo "  ok  fastlane" || echo "  MISSING fastlane (brew install fastlane)"
	@command -v pnpm     >/dev/null 2>&1 && echo "  ok  pnpm"     || echo "  MISSING pnpm"
	@command -v cargo    >/dev/null 2>&1 && echo "  ok  cargo"    || echo "  MISSING rust toolchain (rustup.rs)"
	@echo "== config =="
	@test -f $(ENV_FILE) && echo "  ok  $(ENV_FILE)" || echo "  MISSING $(ENV_FILE) (cp fastlane/.env.example fastlane/.env)"
	@test -n "$(ASC_KEY_FILEPATH)" && test -f "$(ASC_KEY_FILEPATH)" && echo "  ok  App Store Connect key" || echo "  MISSING App Store Connect .p8 (ASC_KEY_FILEPATH)"
	@test -n "$(SUPPLY_JSON_KEY_FILE)" && test -f "$(SUPPLY_JSON_KEY_FILE)" && echo "  ok  Play service account" || echo "  MISSING Play service-account json (SUPPLY_JSON_KEY_FILE)"

bump: ## Set version in src-tauri/tauri.conf.json (make bump VERSION=1.2.3)
	@test -n "$(VERSION)" || { echo "Usage: make bump VERSION=1.2.3"; exit 1; }
	cd src-tauri && sed -i.bak 's/"version": "[^"]*"/"version": "$(VERSION)"/' tauri.conf.json && rm -f tauri.conf.json.bak
	@echo "version -> $(VERSION)"

# ---------------------------------------------------------------- iOS

ios-create: ## Create the App Store Connect app record + bundle id
	fastlane ios create

ios-build: ## Build a store-ready signed .ipa
	APPLE_API_KEY="$(ASC_KEY_ID)" \
	APPLE_API_ISSUER="$(ASC_ISSUER_ID)" \
	APPLE_API_KEY_PATH="$(ASC_KEY_FILEPATH)" \
	pnpm exec tauri ios build --export-method app-store-connect

ios-submit: ## Upload the newest .ipa to TestFlight
	fastlane ios submit

ios-release: ios-build ios-submit ## Build then upload the .ipa

# ------------------------------------------------------------ Android

android-create: ## Validate Play service-account access (first app/upload is manual — see SKILL.md)
	fastlane android create

android-build: ## Build a release .aab
	pnpm exec tauri android build --aab

android-submit: ## Upload the newest .aab to the internal track
	fastlane android submit

android-release: android-build android-submit ## Build then upload the .aab

# --------------------------------------------------------------- both

release-all: ios-release android-release ## Release to both stores
