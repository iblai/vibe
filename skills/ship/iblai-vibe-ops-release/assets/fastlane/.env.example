# Copy to fastlane/.env and fill in. NEVER commit fastlane/.env or the key files.
# How to obtain each value: references/credentials.md

# ---- Shared ----
APP_NAME=My App
# APP_LANGUAGE=en-US
# APP_VERSION=1.0
# APP_SKU=com.example.app        # defaults to the iOS bundle id

# ---- Apple / App Store Connect ----
IOS_APP_IDENTIFIER=com.example.app
APPLE_ID=you@example.com
APPLE_TEAM_ID=XXXXXXXXXX          # Developer Portal > Membership > Team ID
# APPLE_ITC_TEAM_ID=              # only if your Apple ID belongs to several ASC teams

# App Store Connect API key (.p8): Users and Access > Integrations > App Store Connect API
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_FILEPATH=./fastlane/AuthKey_XXXXXXXXXX.p8

# Only needed if `make ios-create` falls back to Apple-ID (session) auth:
# FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=abcd-efgh-ijkl-mnop

# ---- Google Play ----
ANDROID_PACKAGE_NAME=com.example.app
SUPPLY_JSON_KEY_FILE=./fastlane/play-service-account.json
PLAY_TRACK=internal               # internal | alpha | beta | production
