# Fastlane Appfile — values come from fastlane/.env (see .env.example)
# Docs: https://docs.fastlane.tools/advanced/#appfile

app_identifier(ENV["IOS_APP_IDENTIFIER"])   # e.g. com.example.app
apple_id(ENV["APPLE_ID"])                    # your Apple ID email (app creation)
team_id(ENV["APPLE_TEAM_ID"])                # Developer Portal team id
itc_team_id(ENV["APPLE_ITC_TEAM_ID"]) if ENV["APPLE_ITC_TEAM_ID"].to_s != ""

for_platform :android do
  package_name(ENV["ANDROID_PACKAGE_NAME"])  # e.g. com.example.app
  json_key_file(ENV["SUPPLY_JSON_KEY_FILE"]) # Play service-account json
end
