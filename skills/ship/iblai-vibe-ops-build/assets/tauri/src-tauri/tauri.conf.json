{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My App",
  "identifier": "com.example.myapp",
  "version": "0.1.0",
  "build": {
    "devUrl": "https://my-app.example.com",
    "frontendDist": "https://my-app.example.com"
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "msi",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "My Company",
    "homepage": "https://my-app.example.com",
    "copyright": "© 2026 My Company",
    "category": "Utility",
    "shortDescription": "My App",
    "longDescription": "My App — built on the ibl.ai platform. One codebase on web, macOS, Windows, Linux, iOS and Android.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "my-app"
          ]
        }
      ]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    },
    "windows": []
  }
}
