# ibl.ai configuration — copy to .env.local (gitignored) and set your values.
# The four URLs below mirror the code defaults in lib/iblai/config.ts (hosted
# iblai.app), so the app works without them — they are listed here as the
# knobs to change when self-hosting. NEXT_PUBLIC_MAIN_TENANT_KEY is required;
# IBLAI_API_KEY (a secret — never commit it) unlocks server-side platform
# API calls via config.apiKey(), and doubles as a standard OpenAI api key at
# https://asgi.data.<domain>/api/ai-mentor/orgs/<tenant>/v1 (chat completions
# + models) for the app's LLM features — no separate provider key needed.
# Distributed self-hosted mode: delete the NEXT_PUBLIC_API_BASE_URL line
# (and set your own NEXT_PUBLIC_PLATFORM_BASE_DOMAIN) so each service derives
# its own subdomain — editing only the domain keeps you on this single origin.
NEXT_PUBLIC_API_BASE_URL=https://api.iblai.app
NEXT_PUBLIC_AUTH_URL=https://login.iblai.app
NEXT_PUBLIC_BASE_WS_URL=wss://asgi.data.iblai.app
NEXT_PUBLIC_PLATFORM_BASE_DOMAIN=iblai.app
NEXT_PUBLIC_MAIN_TENANT_KEY=your-platform
IBLAI_API_KEY=your-token

# The agent the home page chats with: the last path segment of its os.ibl.ai
# URL, https://os.ibl.ai/platform/<org-key>/<agent-uuid>. Leave empty to let an
# admin pick or create one on /setup (stored in the org's metadata; env wins).
NEXT_PUBLIC_DEFAULT_AGENT_ID=
# What the browser tab and the setup screen call the app: two or three Title
# Case words ("Acme Support"), never a slug. Also settable on /setup.
NEXT_PUBLIC_APP_NAME=
# Shown in the chat footer / error toasts.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Where a $0 checkout returns the user. Empty uses the page's origin; an ibl.ai
# official app sets its hosted origin (https://<app>.iblai.me).
NEXT_PUBLIC_APP_URL=

# Credits (how your organization pays ibl.ai). On by default: the navbar shows
# the credit balance to admins and free-trial users, and running out of credits
# opens the SDK's next step (Billing, the plan picker, or a contact-your-admin
# notice). Set to false on an app whose organization is not billed this way.
NEXT_PUBLIC_STRIPE_ENABLED=true
# Plan picker: the bullets on each plan's card, separated by "|". **text** shows
# in bold. Leave a variable unset or empty to keep the SDK's built-in bullets.
NEXT_PUBLIC_PLAN_FEATURES_FREE="**Monthly credits** to try agents, renewed each month|Build agents on any model, trained on your own documents|Chat on web, desktop and mobile|Documentation and community support"
NEXT_PUBLIC_PLAN_FEATURES_PRO="**More credits every month**, with auto-recharge when you want it|Voice, workflows and your tools through MCP|Analytics, embedding and the API|**Email support**"
NEXT_PUBLIC_PLAN_FEATURES_MAX="**A much larger monthly credit allowance**|Evaluations, spend limits and monetization|Roles and teams for access control|**Priority support** and early access"
NEXT_PUBLIC_PLAN_FEATURES_ULTRA="**The largest monthly credit allowance**|Several organizations and single sign-on|Hand-off to human agents|**Dedicated support** and hands-on onboarding"
