# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing — playwright/.auth holds live session tokens from e2e/auth.setup.ts
/coverage
/playwright/
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — only the *.example templates are committed. Real env files
# (.env.local with your tenant key + secrets, iblai.env with your platform
# token) must never be committed.
.env*
!.env.example
!.env.*.example
iblai.env*
!iblai.env.example
!iblai.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agents
.agents/skills
.claude/skills
