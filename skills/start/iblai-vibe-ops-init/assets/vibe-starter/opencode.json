{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "iblai": {
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "@iblai/mcp"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": true
    }
  }
}
