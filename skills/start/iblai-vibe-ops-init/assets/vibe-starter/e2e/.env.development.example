# Playwright E2E configuration — the gitignored copy is e2e/.env.development.
# `pnpm e2e:accounts` creates an org admin and a member in your organization
# and fills in the four PLAYWRIGHT_* values (the *_USERNAME values are emails).
# auth.setup.ts needs the admin pair; without the member pair the member
# journeys skip.
APP_HOST=http://localhost:3000
AUTH_HOST=https://login.iblai.app
PLAYWRIGHT_USERNAME=
PLAYWRIGHT_PASSWORD=
PLAYWRIGHT_MEMBER_USERNAME=
PLAYWRIGHT_MEMBER_PASSWORD=
