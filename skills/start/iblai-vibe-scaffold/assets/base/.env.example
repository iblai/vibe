# ibl.ai platform — copy to .env.local (gitignored) and set your values. The
# four URLs are the hosted defaults; change them only when self-hosting.
NEXT_PUBLIC_API_BASE_URL=https://api.iblai.app
NEXT_PUBLIC_AUTH_URL=https://login.iblai.app
NEXT_PUBLIC_BASE_WS_URL=wss://asgi.data.iblai.app
NEXT_PUBLIC_PLATFORM_BASE_DOMAIN=iblai.app

# Your organization's key and a Platform API Token (a secret — never commit it)
NEXT_PUBLIC_MAIN_TENANT_KEY=your-platform
IBLAI_API_KEY=your-token

# The agent the home page chats with (agent apps); leave empty in the base app
NEXT_PUBLIC_DEFAULT_AGENT_ID=

# Tauri (desktop/mobile builds only)
# NEXT_PUBLIC_TAURI_CUSTOM_SCHEME=my-app

# Support
NEXT_PUBLIC_SUPPORT_EMAIL=support@ibl.ai
