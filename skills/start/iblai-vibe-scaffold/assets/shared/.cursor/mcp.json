{
  "mcpServers": {
    "iblai-js-mcp": {
      "command": "pnpm",
      "args": ["dlx", "@iblai/mcp"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    }
  }
}
